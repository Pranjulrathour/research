# Large raw data: re-downloadable from the sources recorded in each papers/*/data/SNAPSHOT.json
papers/*/data/*.hdf5
papers/*/data/*.csv
papers/*/data/*.parquet
papers/*/data/*.arff
!papers/*/data/SNAPSHOT.json

# Build outputs (paper build/ also holds the plotting caches written by --plots-only runs)
books/*/build/
papers/*/build/
*.pkl
*.epub
*.pdf
__pycache__/
*.pyc
.ipynb_checkpoints/
